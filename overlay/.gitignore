# Build outputs and per-machine state of the overlay app.
.task
bin
node_modules
frontend/node_modules

# frontend/dist is generated, but main.go embeds it, so a fresh clone keeps
# a placeholder to let `go vet` and `go test` run before the first build.
frontend/dist/*
!frontend/dist/.gitkeep

# Generated by `wails3 build` from the Go services.
frontend/bindings

build/linux/appimage/build

# License-check fixtures keep their fake packages.
!scripts/testdata/**/node_modules
frontend/.vitest
